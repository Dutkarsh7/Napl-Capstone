# Smart Pharmacy Environment Configuration
# Copy this file to .env and customize for your local or production environment.

# Go Backend
PORT=8080
# Leave DATABASE_URL empty to use the fast in-memory store, or supply your PostgreSQL connection string:
DATABASE_URL=postgres://postgres:your_secure_password@localhost:5432/smart_pharmacy?sslmode=disable
JWT_SECRET=your_super_secret_jwt_hmac_signing_key_at_least_32_chars
UPLOAD_DIR=./uploads
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
WORKER_POOL_SIZE=4
WORKER_QUEUE_CAP=100

# Microservices Integration Endpoints
OCR_SERVICE_URL=http://localhost:8000
VALIDATION_SERVICE_URL=http://localhost:5005

# F# Validation Microservice
VALIDATION_PORT=5005

# Python OCR Microservice
OCR_PORT=8000
